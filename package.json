{
  "name": "vqsv-web-native",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "format": "prettier --write \"src/**/*.{ts,css}\" \"scripts/*.mjs\" \"oracle/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.{ts,css}\" \"scripts/*.mjs\" \"oracle/*.mjs\"",
    "export:story-data": "node scripts/export-event-scenes.mjs",
    "export:map-collision": "node scripts/export-map-collision.mjs",
    "export:font": "node scripts/export-font.mjs",
    "test:oracle": "vitest run --config vitest.oracle.config.ts",
    "oracle:verify-pack": "node scripts/pack-provenance.mjs",
    "oracle:record-pack": "node scripts/pack-provenance.mjs --record",
    "export:area-maps": "node scripts/export-area-maps.mjs",
    "export:bag-items": "node scripts/export-bag-items.mjs",
    "export:pet-species": "node scripts/export-pet-species.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^5.0.5"
  }
}
